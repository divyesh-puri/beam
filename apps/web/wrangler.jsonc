// Beam site and Connect auth/dashboard, built with TanStack Start on Workers.
//
// Both environments use non-routable placeholders until Beam Cloud is provisioned.
// The @cloudflare/vite-plugin resolves the environment at BUILD time via
// CLOUDFLARE_ENV (not `wrangler deploy --env`): the build writes the resolved
// config to dist/server/wrangler.json and a plain `wrangler deploy` follows
// the .wrangler/deploy/config.json redirect to it.
//
// Deploy staging: pnpm --filter @bb/web build && pnpm --filter @bb/web exec wrangler deploy
// Deploy prod:    CLOUDFLARE_ENV=production pnpm --filter @bb/web build
//                 && pnpm --filter @bb/web exec wrangler deploy
// Secrets (per worker): wrangler secret put [--name beam-web] GITHUB_CLIENT_ID /
//   GITHUB_CLIENT_SECRET / BETTER_AUTH_SECRET / RESEND_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beam-web-staging",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "BASE_DOMAIN": "connect-staging.beam.invalid",
    "APP_URL": "https://web-staging.beam.invalid",
    "LANDING_TELEMETRY": "false",
    "RESEND_AUDIENCE_ID": "",
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "BETTER_AUTH_SECRET",
      "RESEND_API_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beam-connect-staging",
      "database_id": "PROVISION_BEAM_CONNECT_STAGING_D1_ID",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL_DO",
        "class_name": "TunnelDO",
        "script_name": "beam-connect-staging",
      },
    ],
  },
  // A Beam-owned publisher may upload marketplace.json and icons here;
  // /marketplace/v1/* serves them.
  // The route answers 404 until the bucket exists, so this binding can land
  // before the bucket is provisioned.
  "r2_buckets": [
    {
      "binding": "MARKETPLACE",
      "bucket_name": "beam-marketplace-staging",
    },
  ],
  "routes": [],
  "env": {
    // Production remains non-routable until Beam-owned Cloudflare resources,
    // authentication, email, analytics, and DNS are provisioned.
    "production": {
      "name": "beam-web",
      "workers_dev": false,
      "observability": { "enabled": true },
      "routes": [],
      "secrets": {
        "required": [
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "BETTER_AUTH_SECRET",
          "RESEND_API_KEY",
        ],
      },
      "vars": {
        "BASE_DOMAIN": "connect.beam.invalid",
        "APP_URL": "https://beam.invalid",
        "LANDING_TELEMETRY": "false",
        "RESEND_AUDIENCE_ID": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "beam-connect-prod",
          "database_id": "PROVISION_BEAM_CONNECT_PROD_D1_ID",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "TUNNEL_DO",
            "class_name": "TunnelDO",
            "script_name": "beam-connect",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "MARKETPLACE",
          "bucket_name": "beam-marketplace",
        },
      ],
    },
  },
}
