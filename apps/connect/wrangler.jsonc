// Beam Connect — tunnel gate worker + TunnelDO.
//
// The gate resolves `<handle>.<BASE_DOMAIN>` to a server row in D1, authenticates
// the tunnel client by durable credential and visitors by better-auth session,
// then proxies through the per-handle TunnelDO. Production and staging domains,
// databases, and account ownership must be provisioned before deployment.
//
// Deploy prod:    pnpm --filter @bb/connect exec wrangler deploy
// Deploy staging: pnpm --filter @bb/connect exec wrangler deploy --env staging
// Secret: wrangler secret put BETTER_AUTH_SECRET [--env staging]
//         (must equal the account app's BETTER_AUTH_SECRET — the gate verifies
//         the session cookie's HMAC with it)
// Optional var: ASSETLINKS_SHA256_FINGERPRINTS — comma-separated Android
//         signing-cert fingerprints for /.well-known/assetlinks.json. Unset
//         until the Beam Android app is signed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beam-connect",
  "main": "./src/worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }],
  },
  // The reserved .invalid domain prevents accidental production traffic until
  // Beam-owned DNS and Cloudflare resources are provisioned.
  "vars": { "APPLE_APP_ID": "", "BASE_DOMAIN": "connect.beam.invalid" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beam-connect-prod",
      "database_id": "PROVISION_BEAM_CONNECT_PROD_D1_ID",
      // Shared schema lives in connect-db; CI runs `wrangler d1 migrations
      // apply DB --remote` from this config before every deploy (the
      // d1_migrations tracking tables were seeded with the hand-applied
      // 0000-000N chain on 2026-07-08).
      "migrations_dir": "../../packages/connect-db/migrations",
    },
  ],
  "routes": [],
  "env": {
    "staging": {
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
      "durable_objects": {
        "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }],
      },
      "vars": {
        "APPLE_APP_ID": "",
        "BASE_DOMAIN": "connect-staging.beam.invalid",
      },
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "beam-connect-staging",
          "database_id": "PROVISION_BEAM_CONNECT_STAGING_D1_ID",
          "migrations_dir": "../../packages/connect-db/migrations",
        },
      ],
    },
  },
}
