// Beam demo server — the mock server an App Store reviewer connects to.
//
// No Beam deployment is provisioned. After an operator configures a Beam-owned
// Cloudflare account, deploy with:
//   pnpm --filter @bb/demo-server exec wrangler deploy
//
// The workers.dev route is disabled and no custom route is declared. Enable a
// Beam-owned domain only after DNS and distribution provisioning are ready.
//
// Per-client isolation keys on the `cf-connecting-ip` header (src/worker.ts).
// workers.dev sets it; anything that proxies this worker would collapse every
// visitor into one shared world, so do not put it behind another proxy.
//
// No D1, no secrets, no bindings beyond the Durable Object: the demo holds
// fixed fixtures and in-memory per-client state only (one object per client
// address, see src/worker.ts). Nothing here can reach a real Beam server, a
// machine, or a user's data.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beam-demo-server",
  "main": "./src/worker.ts",
  "workers_dev": false,
  "routes": [],
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoStateDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "DEMO_STATE", "class_name": "DemoStateDO" }],
  },
}
